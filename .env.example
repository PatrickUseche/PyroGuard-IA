# Clave opcional para proteger el endpoint de predicción en despliegues públicos.
# Si se configura aquí, define la misma variable en el backend y envía X-AI-API-Key.
AI_API_KEY=

# Con APP_ENV=production el servicio no arranca si AI_API_KEY está vacía.
APP_ENV=

# Puerto de uvicorn en Docker (`${PORT:-8001}`); Render y Vercel lo fijan solos.
PORT=8001

# Usadas solo por scripts/7_verificar_despliegue.py para comprobar un despliegue.
# AI_SERVICE_URL=https://pyro-guard-ia.vercel.app
